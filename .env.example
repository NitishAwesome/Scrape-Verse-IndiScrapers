# Scraper mode: "mock" (local dev) or "brightdata" (live API)
SCRAPER_MODE=mock

# Mock scraper settings (used when SCRAPER_MODE=mock)
MOCK_COLLECTOR_ID=c_mock_123456
MOCK_SITE_PATH=mock-site/index.html

# Bright Data credentials (used when SCRAPER_MODE=brightdata)
# Never commit real values — copy this file to .env and fill in locally.
BRIGHTDATA_API_TOKEN=your_api_token_here
BRIGHTDATA_COLLECTOR_ID=your_collector_id_here
BRIGHTDATA_API_BASE_URL=https://api.brightdata.com
BRIGHTDATA_TIMEOUT_SECONDS=30
